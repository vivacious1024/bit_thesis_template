{
    "name": "bit-write",
    "description": "Offline Typst writing desktop app",
    "author": "bit-write",
    "private": true,
    "version": "0.1.0",
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "vite --configLoader native",
        "dev:all": "concurrently \"npm run dev:converter\" \"npm run dev:web\"",
        "dev:web": "vite --configLoader native",
        "dev:converter": "node ./server/cover-convert-server.mjs",
        "build": "vite build --configLoader native",
        "preview": "vite preview --configLoader native",
        "converter": "node ./server/cover-convert-server.mjs",
        "desktop:dev": "concurrently -k \"npm run dev:web\" \"npm run electron:dev\"",
        "electron:dev": "cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .",
        "desktop:build": "npm run build && electron-builder"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "multer": "^2.1.1",
        "pdf-lib": "^1.17.1",
        "pdfjs-dist": "^4.10.38",
        "vue": "^3.5.32"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.6",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^37.2.6",
        "electron-builder": "^26.0.12",
        "vite": "^8.0.4"
    },
    "build": {
        "appId": "com.bitwrite.desktop",
        "productName": "bit-write",
        "files": [
            "dist/**/*",
            "electron/**/*",
            "server/**/*",
            "src/**/*",
            "public/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "server/**/*"
        ],
        "extraResources": [
            {
                "from": "resources/template_for_bit_graduate_project.typ",
                "to": "template_for_bit_graduate_project.typ"
            },
            {
                "from": "resources/china-national-standard-gb-t-7714-2015-numeric.csl",
                "to": "china-national-standard-gb-t-7714-2015-numeric.csl"
            },
            {
                "from": "build/icons/icon.png",
                "to": "icon.png"
            },
            {
                "from": "vendor/typst",
                "to": "typst"
            }
        ],
        "directories": {
            "output": "dist-electron"
        },
        "afterPack": "electron-builder-hooks.cjs",
        "npmRebuild": false,
        "electronDist": "node_modules/electron/dist",
        "win": {
            "signAndEditExecutable": false,
            "icon": "build/icons/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": false,
            "createDesktopShortcut": "always",
            "createStartMenuShortcut": true,
            "shortcutName": "bit-write",
            "installerIcon": "build/icons/icon.ico",
            "uninstallerIcon": "build/icons/icon.ico",
            "installerHeaderIcon": "build/icons/icon.ico"
        }
    }
}
